                        <h3 className="text-sm font-bold drop-shadow-md leading-tight">{values.headline || "Headline"}</h3>
                        <p className="text-[8px] opacity-90 drop-shadow-sm mt-1">{values.subheadline || "Subheadline text"}</p>
