                        <TableCell>
                          <Badge variant="outline" className={cn("rounded-full px-2 py-0.5 border-none", vStatus.class)}>
                            <vStatus.icon className="mr-1.5 h-3 w-3" />
                            {vStatus.label}
                          </Badge>
