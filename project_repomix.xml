                    <FormItem className="flex flex-row items-center justify-between rounded-2xl border p-3 shadow-sm">
                      <div className="space-y-0.5">
                        <FormLabel>Active</FormLabel>
                        <FormDescription className="text-[10px]">
                          Show on storefront
                        </FormDescription>
                      </div>
                      <FormControl>
                        <Switch
